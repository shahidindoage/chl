// Built so far: Modules 9, 1, 2, 3, 4, 6, 5, 7, 8, 10 and 11 (Auth, Tournament,
// Team, Player, Match, Standings, Live Score, News & Media, Fan Engagement,
// Admin Portal Polish, Web Push Notifications).
// Later modules add their models as they are built (Section 4 step A).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  team_owner
  content_manager
  score_manager
  quiz_manager
  fan
}

enum TournamentFormat {
  league
  knockout
  group_knockout
}

enum PlayerPosition {
  goalkeeper
  defender
  midfielder
  forward
  /// Role not decided yet. Shown as "To Be Confirmed".
  tbc
}

enum MatchStatus {
  upcoming
  live
  completed
  cancelled
}

enum MatchEventType {
  goal
  penalty
  card
  substitution
  period_start
  period_end
  other
}

enum CommentaryType {
  goal
  penalty
  card
  substitution
  period
  injury
  info
  other
}

enum TournamentStatus {
  draft
  upcoming
  ongoing
  completed
  cancelled
}

enum NewsCategory {
  match_report
  preview
  league_update
  spotlight
  interview
  announcement
}

model Tournament {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  season    String
  format    TournamentFormat   @default(league)
  rules     String?
  startDate DateTime
  endDate   DateTime
  status    TournamentStatus   @default(draft)
  logo      String?
  isActive  Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  teams Team[]
  players Player[]
  matches Match[]

  @@unique([season, name])
  @@index([status])
  @@index([isActive])
  @@index([startDate])
}

model Venue {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  city      String
  capacity  Int?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@index([city])
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  shortName   String
  logo        String?
  /// Card art shown behind the team's circular crest on public team cards.
  /// /uploads/... or an http(s) URL — validated at the schema boundary.
  backgroundImage String?
  /// Wide banner art behind the team profile hero.
  heroImage     String?
  /// Social links shown as icons under the team name on the profile hero.
  websiteUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  xUrl          String?
  /// Team captain — must be a player on this squad (enforced in the service).
  captainId     String?    @db.Uuid
  captain       Player?    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  /// Display name of the owning franchise, e.g. a company name. ownerId stays
  /// the linked login, this is just what the public page shows.
  ownerName     String?
  /// Portrait/logo shown beside the owner on the team profile.
  ownerImage    String?
  color1      String       @default("#0a6cc2") // hex, validated at the schema boundary
  color2      String?
  tournamentId String      @db.Uuid
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  coachName   String?
  coachImage  String?
  ownerId     String?      @db.Uuid
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sponsors Sponsor[]
  players  Player[]
  teamAMatches  Match[] @relation("MatchTeamA")
  teamBMatches  Match[] @relation("MatchTeamB")
  matchEvents   MatchEvent[] @relation("EventTeam")
  followers     TeamFollow[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([ownerId])
}

model Player {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  image        String?
  jerseyNumber Int
  position     PlayerPosition
  dateOfBirth  DateTime
  nationality  String
  teamId       String         @db.Uuid
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Denormalized from the team so directory filters by tournament don't need a join.
  tournamentId String         @db.Uuid
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchEvents   MatchEvent[] @relation("EventPlayer")
  /// Country flag badge on squad cards (small circular icon).
  flagImage      String?
  /// Art behind the player photo on squad cards.
  backgroundImage String?
  /// Team this player captains, if any.
  captainOf      Team[]     @relation("TeamCaptain")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([teamId, jerseyNumber])
  @@index([teamId])
  @@index([tournamentId])
  @@index([position])
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  tournamentId  String      @db.Uuid
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamAId       String      @db.Uuid
  teamA         Team        @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamBId       String      @db.Uuid
  teamB         Team        @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  venueId       String?     @db.Uuid
  venue         Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  date          DateTime
  status        MatchStatus @default(upcoming)
  teamAScore    Int         @default(0)
  teamBScore    Int         @default(0)
  // Live fields are written by Module 5 (live-score), read-only for the rest.
  currentMinute Int?
  currentPeriod String?
  isPaused      Boolean  @default(false)
  summary       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  events       MatchEvent[]
  commentaries Commentary[]
  galleries    Gallery[]
  predictions  Prediction[]

  @@index([tournamentId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([venueId])
  @@index([status])
  @@index([date])
}

model Commentary {
  id        String          @id @default(uuid()) @db.Uuid
  matchId   String          @db.Uuid
  match     Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute    Int
  period    String?
  text      String
  type      CommentaryType  @default(info)
  createdAt DateTime        @default(now())

  @@index([matchId])
  @@index([matchId, minute])
}

model MatchEvent {
  id          String          @id @default(uuid()) @db.Uuid
  matchId     String          @db.Uuid
  match       Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  eventType   MatchEventType
  teamId      String?         @db.Uuid
  team        Team?           @relation("EventTeam", fields: [teamId], references: [id], onDelete: SetNull)
  playerId    String?         @db.Uuid
  player      Player?         @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  minute      Int
  period      String?
  description String?
  createdAt   DateTime        @default(now())

  @@index([matchId])
  @@index([matchId, minute])
  @@index([teamId])
  @@index([playerId])
}

model Sponsor {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logo      String?
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, name])
  @@index([teamId])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  name        String
  phone       String?
  password    String? // bcrypt hash; set for every account (fans sign up with password + OTP)
  role        Role     @default(fan)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  otpCodes OtpCode[]
  ownedTeams Team[]
  quizAttempts QuizAttempt[]
  predictions  Prediction[]
  activityLogs ActivityLog[]
  pushSubscriptions PushSubscription[]
  teamFollows  TeamFollow[]

  @@index([role])
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String // sha256 of the 6-digit code — never stored in plaintext
  userId     String?   @db.Uuid
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([email, consumedAt])
  @@index([expiresAt])
}

// ---------- Module 8 — Fan Engagement ----------
// A fan may attempt a quiz once and predict a match once. Both are scored
// automatically, so the leaderboard is a projection of these rows.

enum QuizQuestionType {
  single_choice
  true_false
}

enum QuizStatus {
  draft
  active
  closed
}

model Quiz {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      QuizStatus  @default(draft)
  // One point per correct answer unless a question overrides it.
  pointsPerQuestion Int   @default(1)
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([status])
  @@index([closesAt])
}

model QuizQuestion {
  id       String            @id @default(uuid()) @db.Uuid
  quizId   String            @db.Uuid
  quiz     Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question String
  type     QuizQuestionType  @default(single_choice)
  // Exactly one entry is correct; scoring compares by option key, never by text.
  options  Json
  correctKey String
  points   Int?
  position Int               @default(0)

  answers QuizAnswer[]

  @@index([quizId, position])
}

model QuizAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  quizId     String   @db.Uuid
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Int      @default(0)
  maxScore   Int      @default(0)
  submittedAt DateTime @default(now())

  answers QuizAnswer[]

  // One attempt per quiz per fan.
  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId, score])
}

model QuizAnswer {
  id         String       @id @default(uuid()) @db.Uuid
  attemptId  String       @db.Uuid
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String       @db.Uuid
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedKey String
  isCorrect  Boolean      @default(false)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Prediction {
  id          String   @id @default(uuid()) @db.Uuid
  matchId     String   @db.Uuid
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedWinnerId String @db.Uuid
  predictedScore String?
  isCorrect   Boolean?
  scoredAt    DateTime?
  createdAt   DateTime @default(now())

  // One prediction per match per fan.
  @@unique([matchId, userId])
  @@index([matchId, isCorrect])
  @@index([userId])
}

// ---------- Module 7 — News & Media ----------
// Article/Reel/Gallery are authored by content_manager and only become public
// when isPublished flips to true (Section 8 Module 7).

model Article {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  slug        String       @unique
  summary     String?
  content     String
  image       String?
  category    NewsCategory @default(league_update)
  tags        String[]
  isFeatured  Boolean      @default(false)
  isPublished Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([isFeatured])
}

model Reel {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  videoUrl    String
  thumbnail   String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Gallery {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  /// Card cover on the public gallery index. Falls back to the first image.
  thumbnailUrl String?
  /// Album hero banner. Falls back to the cover, then the first image.
  bannerUrl       String?
  /// Phone crop of the album hero. Falls back to bannerUrl.
  bannerMobileUrl String?
  matchId     String?   @db.Uuid
  match       Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images GalleryImage[]

  @@index([matchId])
  @@index([isPublished, publishedAt])
}

model GalleryImage {
  id        String  @id @default(uuid()) @db.Uuid
  url       String
  caption   String?
  sortOrder Int     @default(0)
  galleryId String  @db.Uuid
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
}

// ---------- Module 10 — Admin Portal Polish ----------

/// Append-only audit trail of admin write actions. Written by the activity-log
/// module, read by the admin log viewer. No updatedAt — entries are immutable.
model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // null only if the user was deleted afterwards
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String? // snapshot, so the entry stays readable after a rename
  userRole  Role?
  /// Dotted action verb, e.g. "team.create", "match.result.update".
  action    String
  /// Entity kind the action targeted, e.g. "team", "match", "article".
  entity    String
  entityId  String?
  /// Small JSON blob of context — ids, changed field names, counts. Never secrets.
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity])
  @@index([userId, createdAt])
}

// ---------- Module 11 - Web Push Notifications ----------

/// One browser/device Push API subscription. A user on three devices has three
/// rows. Endpoints go stale constantly (browsers rotate them), so rows are
/// deleted on 404/410 rather than left to accumulate.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Browser-generated endpoint URL — globally unique, which is how a
  /// re-subscribe updates in place instead of duplicating.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// The opt-in: a fan follows a team and gets a push when that team goes live.
/// This is the only notification preference — a global "notify me everything"
/// switch was deliberately avoided, because fans who mute once never come back.
model TeamFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
}
